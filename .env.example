# LASTLY - Environment Variables Example
# 실제 비밀값은 이 파일에 넣지 않는다.
# 개발 환경에서는 .env.local, 배포 환경에서는 플랫폼 환경변수를 사용한다.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Seoul
APP_ENV=development
APP_DEBUG=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_PARSER_SCHEMA_VERSION=1.0
AI_PARSER_PROMPT_VERSION=1.1
AI_PARSER_TIMEOUT_MS=15000

# STT Provider
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Internal notification / scheduled job protection
INTERNAL_CRON_SECRET=

# Product limits
MAX_SEMANTIC_ACTIONS=5
MAX_AI_INPUT_LENGTH=500
NOTIFICATION_SNOOZE_OPTIONS=1,3,7

# ---------------------------------------------------------
# Security notes
# ---------------------------------------------------------
# Browser-safe:
# - NEXT_PUBLIC_APP_URL
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY
#
# Server-only:
# - SUPABASE_SERVICE_ROLE_KEY
# - AI_API_KEY
# - STT_API_KEY
# - VAPID_PRIVATE_KEY
# - INTERNAL_CRON_SECRET
#
# LASTLY baseline:
# - Application API/BFF is the canonical write path.
# - Production browser direct Core DB writes must be blocked.
# - Service role and provider secrets must never be exposed to client code.
# - User ownership and RLS rules must not be bypassed.
